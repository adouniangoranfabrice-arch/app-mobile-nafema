{
  "expo": {
    "name": "nafema",
    "slug": "nafema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_nefama.png",
    "scheme": "nafemamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo_nefama.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5EAEB",
        "foregroundImage": "./assets/images/logo_nefama.png",
        "backgroundImage": "./assets/images/logo_nefama.png",
        "monochromeImage": "./assets/images/logo_nefama.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo_nefama.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_nefama.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5EAEB"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
