{
  "expo": {
    "name": "nafema",
    "slug": "nafema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_nefama.png",
    "scheme": "nafemamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo_nefama.png",
      "bundleIdentifier": "com.fabrice01.nafema"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4EAEA",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fabrice01.nafema"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo_nefama.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_nefama.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5EAEB"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "33097aa0-8768-4e52-8d47-23f8450fb572"
      }
    }
  }
}
